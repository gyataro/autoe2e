BASE_URL="http://localhost:3000"

# One multimodal chat model is used for every inference task. This example targets
# an OpenAI-compatible local server such as vLLM or llama.cpp.
LLM_MODEL="Qwen/Qwen3-VL-8B-Instruct"
LLM_BASE_URL="http://localhost:8000/v1"
LLM_API_KEY="local"

EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_BASE_URL="http://localhost:8000/v1"
EMBEDDING_API_KEY="local"

# Enable the noVNC browser view. Startup intervention pauses for Enter after you
# authenticate in that same browser context.
REMOTE_VIEW_ENABLED=false
REMOTE_STARTUP_INTERVENTION=false
