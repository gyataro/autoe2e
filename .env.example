APP_NAME="autoe2e"
BASE_URL="http://localhost:3000"
OUTPUT_DIR="./output"
# DATABASE_PATH=./output/localhost/autoe2e.sqlite3
HEADLESS="false"

# One multimodal chat model is used for every inference task. This example targets
# an OpenAI-compatible local server such as vLLM or llama.cpp.
LLM_MODEL="openai:your-local-model"
LLM_BASE_URL="http://localhost:8000/v1"
LLM_API_KEY="local"
LLM_TEMPERATURE="0"
LLM_MAX_TOKENS="1024"
LLM_TIMEOUT="120"
LLM_MAX_RETRIES="2"

EMBEDDING_MODEL="openai:text-embedding-3-large"
EMBEDDING_DIMENSIONS="3072"
# EMBEDDING_BASE_URL="http://localhost:8000/v1"
# EMBEDDING_API_KEY="local"
OPENAI_API_KEY=
